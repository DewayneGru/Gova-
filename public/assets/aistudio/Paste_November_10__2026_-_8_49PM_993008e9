 };
+
+/** Fail-closed with zero discrimination. Any evaluator that scores like this is just escalating everything. */
+export const alwaysEscalate: BenchEvaluator = {
+  name: "baseline:always-escalate",
+  evaluate: () => "ESCALATE",
+};
